<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="水平布局示例"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- 水平布局的MultiChildContainer -->
        <com.baidu.widgetlib.MultiChildContainer
            android:id="@+id/container_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F0F0"
            android:padding="16dp"
            app:orientation="horizontal"
            app:childSpacing="12dp"
            app:childGravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="垂直布局示例"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <!-- 垂直布局的MultiChildContainer -->
        <com.baidu.widgetlib.MultiChildContainer
            android:id="@+id/container_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F0F0"
            android:padding="16dp"
            app:orientation="vertical"
            app:childSpacing="16dp"
            app:childGravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="动态添加示例"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <!-- 动态添加子控件的容器 -->
        <com.baidu.widgetlib.MultiChildContainer
            android:id="@+id/container_dynamic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F0F0"
            android:padding="16dp"
            app:orientation="horizontal"
            app:childSpacing="8dp"
            app:childGravity="start"/>

        <Button
            android:id="@+id/btn_add_child"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加子控件"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btn_clear_children"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空子控件"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</ScrollView>